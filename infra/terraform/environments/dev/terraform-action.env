# Controla o que a esteira CD Development executa ao entrar na branch develop.
# apply   = cria ou atualiza o API Gateway da Oficina Mecânica.
# destroy = destrói o API Gateway e VPC Link da Oficina Mecânica.
# Disparo controlado após a atualização das credenciais temporárias da AWS Academy.
TERRAFORM_ACTION=destroy
# Reconciliar state após reset: destroy sem dependência de contratos removidos.
# Nova tentativa dedicada: regras órfãs confirmadas após encerramento do laboratório antigo.
# Destroy dedicado: reconciliar cache isolado pela conta AWS do laboratório atual.
